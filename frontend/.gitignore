# Ignore rules for the Next.js frontend.
#
# The repository root has a .gitignore that already covers this directory.
# This file exists so the frontend is safe to use on its own, and documents the
# rules that are specific to it.
#
# The most important rule here is `.env*`: NEXT_PUBLIC_API_URL is not a secret,
# but the file is environment-specific and must not be committed.

# --- Secrets / environment -------------------------------------------------
# .env.local points at your local Django instance. .env.example is the
# committed template and must stay tracked.
.env*
!.env.example

# --- Dependencies ----------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# --- Next.js build output --------------------------------------------------
# .next/ is regenerated by `npm run build`; never commit it.
.next/
out/
/build
next-env.d.ts
*.tsbuildinfo

# --- Testing and coverage --------------------------------------------------
/coverage

# --- Package manager logs --------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Hosting ---------------------------------------------------------------
.vercel

# --- Certificates and keys -------------------------------------------------
# Belt and braces: a stray private key must never reach the repository.
*.pem
*.key
*.p12
*.pfx

# --- Editors and OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Copy to `.env.local` for local development.
# In production set these in your host's environment settings instead.
#
# Never commit real secrets. The API has no secret values to store here: the
# session cookie is set by Django and is HTTP-only.

# Base URL of the Django REST API, without a trailing slash.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# this must be set in the build environment, not only at runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Copy this file to `.env` for local development, or supply these variables
# through your host's environment settings in production.
#
# `.env` is gitignored. Never commit real secrets. Never put a real value in
# THIS file.
#
# In production (DJANGO_DEBUG=false) the application refuses to start if
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS or POSTGRES_PASSWORD is missing.

# --- Core Django -----------------------------------------------------------

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# "true" only for local development. Defaults to false when unset, so an
# unconfigured deployment never serves tracebacks.
DJANGO_DEBUG=true

# Comma-separated hostnames this service answers for. Required in production.
#
# On Vercel this is derived automatically from the deployment hostname when it
# is left empty, so it is usually not set there. Set it explicitly once you
# attach a custom domain, e.g. 'api.example.com'.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- HTTPS / proxy ---------------------------------------------------------

# The PaaS terminates TLS, so Django trusts X-Forwarded-Proto.
# These default to secure values whenever DJANGO_DEBUG is false.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_COOKIES=true

# --- Sessions / CSRF -------------------------------------------------------

# Lifespan of the session cookie, in seconds. Default is 14 days.
# DJANGO_SESSION_COOKIE_AGE=1209600

# Origins allowed to submit unsafe requests. Only needed if a browser ever
# talks to Django directly; the Next.js service proxies all API traffic.
#
# On Vercel, if this is left unset it is derived from the deployment hostname.
# Add the frontend's origin here if you serve the storefront from a different
# domain, e.g. https://shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------

# Local database can be created with:
#   sudo bash scripts/setup_database.sh
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Instead of the five variables above, a single connection string may be given
# as POSTGRES_URL or DATABASE_URL. Any POSTGRES_* variable that is also set
# takes precedence over the matching part of the URL, so you can mix them.
# Vercel's managed Postgres integration provides this automatically.
# POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Managed PostgreSQL (Render, Neon, RDS, ...) requires TLS. Left unset locally,
# where the connection is over the loopback interface.
# POSTGRES_SSLMODE=require

# Seconds a database connection is reused. Defaults to 0 on Vercel, where the
# app is a serverless function and cached connections can go stale, and 60
# elsewhere. Rarely needs to be set.
# POSTGRES_CONN_MAX_AGE=60

# --- Logging ---------------------------------------------------------------

# One of DEBUG, INFO, WARNING, ERROR.
DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s
